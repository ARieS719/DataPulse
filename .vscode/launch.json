{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pytest：全部测试",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "运行批式流水线（small）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_pipeline.py",
      "args": ["--scale", "small"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "WAP 分支 POC",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/poc_wap.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "生成数据（small）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/foundation/data_gen/generate.py",
      "args": ["--scale", "small"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
